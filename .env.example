# ─────────────────────────────────────────────────────────────
# Life Balance AI – Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA suba o .env para o git!
# ─────────────────────────────────────────────────────────────

# ── LLM (escolha um) ──────────────────────────────────────────
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini (GRATUITO): https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Qual LLM usar: "openai" ou "gemini"
LLM_PROVIDER=gemini

# ── Trello ────────────────────────────────────────────────────
# Como obter: https://trello.com/app-key
TRELLO_API_KEY=...
TRELLO_TOKEN=...
# ID do board principal (aparece na URL do board)
TRELLO_BOARD_ID=...

# ── News API ──────────────────────────────────────────────────
# Cadastro gratuito: https://newsapi.org/register
NEWS_API_KEY=...

# ── Google Calendar ───────────────────────────────────────────
# Tutorial completo de setup: https://developers.google.com/calendar/api/quickstart/python
# Baixe o credentials.json do Google Cloud Console e coloque na raiz do projeto
GOOGLE_CALENDAR_ID=primary

# ── LangSmith (monitoramento) ─────────────────────────────────
# Cadastro gratuito: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=life-balance-ai

# ── Configurações do projeto ──────────────────────────────────
# Temas de notícias de interesse (separados por vírgula)
NEWS_TOPICS=finanças pessoais,saúde,tecnologia,mercado financeiro

# Moeda para formatação
CURRENCY=BRL
